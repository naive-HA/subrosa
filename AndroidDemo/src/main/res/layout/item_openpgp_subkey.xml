<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/subkey_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="2dp"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="── Signature" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.35"
            android:text="@string/openpgp_key_algorithm"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subkey_algorithm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.65"
            android:textSize="12sp"
            tools:text="Ed25519" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.35"
            android:text="@string/openpgp_key_created"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subkey_created"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.65"
            android:textSize="12sp"
            tools:text="2024-01-15" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.35"
            android:text="@string/openpgp_key_expires"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subkey_expires"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.65"
            android:textSize="12sp"
            tools:text="2026-01-15" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.35"
            android:text="@string/openpgp_key_fingerprint"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subkey_fingerprint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.65"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="2"
            android:minLines="2"
            android:textSize="11sp"
            tools:text="AABB CCDD EEFF 0011 2233\n4455 6677 8899 AABB CCDD" />
    </LinearLayout>

</LinearLayout>
